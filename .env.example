# ============================================================
# تنظیمات سرور
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# پایگاه داده MongoDB
# ============================================================
# آدرس اتصال به MongoDB (MongoDB Atlas یا Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/digishop?retryWrites=true&w=majority

# ============================================================
# تنظیمات JWT
# ============================================================
# کلید مخفی JWT (یک رشته تصادفی طولانی و امن انتخاب کنید)
JWT_SECRET=your_jwt_secret_key_here
# مدت اعتبار توکن (مثلاً 30d, 7d, 24h)
JWT_EXPIRES_IN=30d

# ============================================================
# سرویس پیامک کاوه‌نگار
# ============================================================
# API Key کاوه‌نگار (از پنل کاوه‌نگار دریافت کنید)
KAVEH_NEGAR_API_KEY=your_kaveh_negar_api_key
# شماره فرستنده (خط خدماتی)
KAVEH_NEGAR_SENDER=3000XXXXX

# ============================================================
# تنظیمات OTP
# ============================================================
# طول کد تأیید (پیش‌فرض: ۵ رقمی)
OTP_LENGTH=5
# مدت اعتبار کد OTP به دقیقه (پیش‌فرض: ۲ دقیقه)
OTP_EXPIRY_MINUTES=2

# ============================================================
# دستیار خرید هوشمند PixelLife (اختیاری)
# ============================================================
# کلید را از داشبورد OpenAI API دریافت و فقط در فایل واقعی .env وارد کنید
OPENAI_API_KEY=اینجا_کلید_API_را_وارد_کنید
# مدل اقتصادی پیشنهادی برای شروع
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# سرویس ایمیل Zoho Mail (SMTP)
# ============================================================
# آدرس ایمیل فرستنده
ZOHO_EMAIL=info@pixellife.ir
# App Password (از پنل Zoho: Accounts > Security > App Passwords — نه پسورد اصلی)
ZOHO_APP_PASSWORD=your_zoho_app_password

# ============================================================
# درگاه پرداخت زرین‌پال
# ============================================================
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL= ***********

# سقف مصرف دستیار هوشمند (اختیاری): هر IP/کاربر در دقیقه، در روز، و کل سایت در روز
AI_RATE_PER_MINUTE=8
AI_RATE_PER_DAY=60
AI_GLOBAL_PER_DAY=3000

# =======================
# امنیت پنل ادمین و نشست
# =======================
# رمز نشست ادمین: یک رشتهٔ تصادفی طولانی (حداقل ۳۲ کاراکتر). با دستور زیر بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# اگر تنظیم نشود، با هر ری‌استارت رمز تازه ساخته می‌شود و ادمین باید دوباره وارد شود.
SESSION_SECRET=
# رمز ورود ادمین به‌صورت هش bcrypt (پیشنهادی). هش را با دستور زیر بسازید و اینجا بگذارید:
#   node scripts/hash-admin-password.js
ADMIN_PASSWORD_HASH=
# روش قدیمی (رمز ساده): فقط تا زمانی که ADMIN_PASSWORD_HASH تنظیم نشده کار می‌کند؛ بعد از تنظیم هش، این خط را پاک کنید.
ADMIN_PASSWORD=
# کلید عبور از «حالت بروزرسانی» (فقط اگر بلوک تعمیرات را دوباره فعال کنید). یک رشتهٔ تصادفی بگذارید و لو ندهید.
MAINTENANCE_BYPASS_KEY=

# =======================
# محدودیت تعداد تلاش (rate limit)
# =======================
# اختیاری؛ مقدار پیش‌فرض در پرانتز. پشت nginx باید هدر X-Forwarded-For درست ارسال شود، وگرنه همهٔ کاربران یک IP دیده می‌شوند.
# RATE_LOGIN_PER_15MIN=20      # ورود با رمز/کد برای هر IP
# RATE_OTP_PER_10MIN=5         # ارسال کد برای هر شمارهٔ موبایل
# RATE_OTP_IP_PER_10MIN=20     # ارسال کد برای هر IP
# RATE_ADMIN_LOGIN_PER_15MIN=8 # تلاش ناموفق ورود ادمین برای هر IP
